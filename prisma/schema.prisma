generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ACCOUNTS
// ============================================================

enum UserRole {
  customer
  seller
  admin
  store_owner
  support
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(customer)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile         SellerProfile?   @relation("SellerUser")
  approvedSellers       SellerProfile[]  @relation("SellerApprover")
  addresses             Address[]
  cart                  Cart?
  wishlist              Wishlist?
  orders                Order[]
  prescriptions         Prescription[]   @relation("PrescriptionOwner")
  reviewedPrescriptions Prescription[]   @relation("PrescriptionReviewer")
  couponUsages          CouponUsage[]
  productReviews        ProductReview[]
  sellerReviews         SellerReview[]
  supportTickets        SupportTicket[]
  sentSupportMessages   SupportMessage[]
  updatedPages          Page[]
}

enum SellerStatus {
  pending
  approved
  suspended
  rejected
}

model SellerProfile {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  user         User         @relation("SellerUser", fields: [userId], references: [id])
  businessName String
  status       SellerStatus @default(pending)
  approvedBy   Int?
  approver     User?        @relation("SellerApprover", fields: [approvedBy], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  products      Product[]
  prescriptions Prescription[]
  orderItems    OrderItem[]
  shipments     Shipment[]
  reviews       SellerReview[]
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  city       String
  area       String?
  street     String?
  building   String?
  apartment  String?
  postalCode String?
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id       Int    @id @default(autoincrement())
  parentId Int?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

enum ProductStatus {
  draft
  active
  inactive
  rejected
}

model Product {
  id                   Int           @id @default(autoincrement())
  sellerId             Int
  seller               SellerProfile @relation(fields: [sellerId], references: [id])
  categoryId           Int
  category             Category      @relation(fields: [categoryId], references: [id])
  brandId              Int?
  brand                Brand?        @relation(fields: [brandId], references: [id])
  name                 String
  description          String?
  sku                  String?
  requiresPrescription Boolean       @default(false)
  status               ProductStatus @default(draft)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  images     ProductImage[]
  attributes ProductAttribute[]
  variants   ProductVariant[]
  reviews    ProductReview[]
}

model ProductImage {
  id        Int             @id @default(autoincrement())
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  url       String
  sortOrder Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
}

model ProductAttribute {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String

  values ProductAttributeValue[]

  @@unique([productId, name])
}

model ProductAttributeValue {
  id          Int              @id @default(autoincrement())
  attributeId Int
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id])
  value       String

  variantLinks VariantAttributeValue[]

  @@unique([attributeId, value])
}

model ProductVariant {
  id             Int      @id @default(autoincrement())
  productId      Int
  product        Product  @relation(fields: [productId], references: [id])
  label          String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  sku            String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images                ProductImage[]
  attributeValues       VariantAttributeValue[]
  inventoryBatches      InventoryBatch[]
  inventoryTransactions InventoryTransaction[]
  cartItems             CartItem[]
  wishlistItems         WishlistItem[]
  orderItems            OrderItem[]

  @@unique([productId, sku])
}

model VariantAttributeValue {
  id               Int                   @id @default(autoincrement())
  variantId        Int
  variant          ProductVariant        @relation(fields: [variantId], references: [id])
  attributeValueId Int
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([variantId, attributeValueId])
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryBatch {
  id                Int      @id @default(autoincrement())
  variantId         Int
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  batchNumber       String?
  expiryDate        DateTime? @db.Date
  quantityReceived  Int      @default(0)
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions     InventoryTransaction[]
  batchAllocations OrderItemBatchAllocation[]

  @@unique([variantId, batchNumber])
}

model InventoryTransaction {
  id               Int             @id @default(autoincrement())
  variantId        Int
  variant          ProductVariant  @relation(fields: [variantId], references: [id])
  inventoryBatchId Int?
  inventoryBatch   InventoryBatch? @relation(fields: [inventoryBatchId], references: [id])
  quantity         Int
  transactionType  String
  referenceType    String?
  referenceId      Int?
  createdAt        DateTime        @default(now())
}

// ============================================================
// CART & WISHLIST
// ============================================================

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id])
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistItem[]
}

model WishlistItem {
  id         Int            @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id])
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  addedAt    DateTime       @default(now())

  @@unique([wishlistId, variantId])
}

// ============================================================
// PRESCRIPTIONS
// ============================================================

enum PrescriptionStatus {
  pending
  approved
  rejected
  expired
}

model Prescription {
  id         Int                @id @default(autoincrement())
  userId     Int
  user       User               @relation("PrescriptionOwner", fields: [userId], references: [id])
  sellerId   Int?
  seller     SellerProfile?     @relation(fields: [sellerId], references: [id])
  imageUrl   String
  status     PrescriptionStatus @default(pending)
  reviewedBy Int?
  reviewer   User?              @relation("PrescriptionReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  orderItems OrderItem[]
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  partially_delivered
  delivered
  cancelled
  refunded
  completed
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int
  user           User        @relation(fields: [userId], references: [id])
  couponId       Int?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  status         OrderStatus @default(pending)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0) @db.Decimal(12, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cancelledAt    DateTime?
  completedAt    DateTime?

  shippingAddress OrderShippingAddress?
  items           OrderItem[]
  shipments       Shipment[]
  payments        Payment[]
  couponUsage     CouponUsage?
  productReviews  ProductReview[]
  sellerReviews   SellerReview[]
}

model OrderShippingAddress {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id])
  recipientName String
  phone         String
  city          String
  area          String?
  street        String?
  building      String?
  apartment     String?
  postalCode    String?
  createdAt     DateTime @default(now())
}

enum OrderItemStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
  refunded
}

model OrderItem {
  id              Int             @id @default(autoincrement())
  orderId         Int
  order           Order           @relation(fields: [orderId], references: [id])
  variantId       Int
  variant         ProductVariant  @relation(fields: [variantId], references: [id])
  sellerId        Int
  seller          SellerProfile   @relation(fields: [sellerId], references: [id])
  shipmentId      Int?
  shipment        Shipment?       @relation(fields: [shipmentId], references: [id])
  prescriptionId  Int?
  prescription    Prescription?   @relation(fields: [prescriptionId], references: [id])
  quantity        Int
  priceAtPurchase Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  itemStatus      OrderItemStatus @default(pending)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  batchAllocations OrderItemBatchAllocation[]
  returnRequest    ReturnRequest?
}

model OrderItemBatchAllocation {
  id               Int            @id @default(autoincrement())
  orderItemId      Int
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id])
  inventoryBatchId Int
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id])
  quantity         Int
  createdAt        DateTime       @default(now())

  @@unique([orderItemId, inventoryBatchId])
}

// ============================================================
// SHIPPING
// ============================================================

enum ShipmentStatus {
  pending
  processing
  shipped
  in_transit
  delivered
  cancelled
  returned
}

model Shipment {
  id             Int            @id @default(autoincrement())
  orderId        Int
  order          Order          @relation(fields: [orderId], references: [id])
  sellerId       Int
  seller         SellerProfile  @relation(fields: [sellerId], references: [id])
  carrier        String?
  trackingNumber String?        @unique
  status         ShipmentStatus @default(pending)
  shippingFee    Decimal        @default(0) @db.Decimal(12, 2)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items OrderItem[]

  @@unique([orderId, sellerId])
}

// ============================================================
// PAYMENTS
// ============================================================

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash_on_delivery
  card
  paypal
  instapay
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  status         PaymentStatus @default(pending)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("EGP")
  provider       String?
  transactionRef String?       @unique
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  paidAt         DateTime?
  refundedAt     DateTime?
}

// ============================================================
// COUPONS
// ============================================================

enum CouponDiscountType {
  percentage
  fixed
}

model Coupon {
  id                Int                @id @default(autoincrement())
  code              String             @unique
  discountType      CouponDiscountType
  discountValue     Decimal            @db.Decimal(12, 2)
  minOrderAmount    Decimal            @default(0) @db.Decimal(12, 2)
  maxDiscountAmount Decimal?           @db.Decimal(12, 2)
  maxUses           Int?
  maxUsesPerUser    Int?
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  orders Order[]
  usages CouponUsage[]
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  couponId Int
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  orderId  Int      @unique
  order    Order    @relation(fields: [orderId], references: [id])
  usedAt   DateTime @default(now())
}

// ============================================================
// RETURNS
// ============================================================

enum ReturnStatus {
  requested
  approved
  rejected
  received
  refunded
  cancelled
}

model ReturnRequest {
  id          Int          @id @default(autoincrement())
  orderItemId Int          @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  reason      String
  status      ReturnStatus @default(requested)
  requestedAt DateTime     @default(now())
  deadline    DateTime?
  approvedAt  DateTime?
  receivedAt  DateTime?
  refundedAt  DateTime?
  updatedAt   DateTime?    @updatedAt
}

// ============================================================
// REVIEWS
// ============================================================

model ProductReview {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId, orderId])
}

model SellerReview {
  id        Int           @id @default(autoincrement())
  sellerId  Int
  seller    SellerProfile @relation(fields: [sellerId], references: [id])
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  orderId   Int
  order     Order         @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([sellerId, userId, orderId])
}

// ============================================================
// SUPPORT
// ============================================================

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

model SupportTicket {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  subject   String
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?

  messages SupportMessage[]
}

model SupportMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  senderId  Int
  sender    User          @relation(fields: [senderId], references: [id])
  message   String
  createdAt DateTime      @default(now())
}

// ============================================================
// CONTENT / CMS
// ============================================================

enum PageStatus {
  draft
  published
  archived
}

model Page {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  title     String
  content   String?
  status    PageStatus @default(draft)
  updatedBy Int?
  updater   User?      @relation(fields: [updatedBy], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}